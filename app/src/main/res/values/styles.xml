<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Botó principal (verd) -->
    <style name="Widget.Shelves.Button" parent="Widget.Material3.Button">
        <item name="android:minHeight">56dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">12dp</item>
    </style>

    <!-- Botó secundari (només vora) -->
    <style name="Widget.Shelves.Button.Secondary" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">56dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">12dp</item>
    </style>

    <!-- Botó de text -->
    <style name="Widget.Shelves.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="android:minHeight">48dp</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <!-- Camps de text -->
    <style name="Widget.Shelves.TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
    </style>

    <!-- Textos -->
    <style name="TextAppearance.Shelves.Title" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:textColor">?attr/colorOnBackground</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.Shelves.Subtitle" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>

    <!-- Targeta d'ajuda -->
    <style name="Widget.Shelves.HelpCard" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginBottom">16dp</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:padding">16dp</item>
        <item name="android:background">@drawable/bg_card</item>
    </style>
    <!-- Targeta estil Shelves: blanca, vora fina, sense ombra -->
    <style name="Widget.Shelves.Card" parent="Widget.Material3.CardView.Outlined">
        <item name="cardBackgroundColor">?attr/colorSurface</item>
        <item name="cardCornerRadius">12dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">?attr/colorOnSurface</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <!-- Botó pastilla amb vora (com "He leído hoy") -->
    <style name="Widget.Shelves.Button.Pill" parent="Widget.Material3.Button.OutlinedButton">
        <item name="backgroundTint">?android:attr/colorBackground</item>
        <item name="strokeColor">?attr/colorOnSurface</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">13sp</item>
        <item name="android:minHeight">48dp</item>
    </style>

    <!-- Títols de secció en serif (com "Frase del mes:") -->
    <style name="TextAppearance.Shelves.SectionTitle" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:fontFamily">serif</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textColor">?attr/colorOnBackground</item>
    </style>
    <!-- cantos redondos para los libros de usuario -->
    <style name="RoundedCover" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">8dp</item>
    </style>

    <style name="RoundedSpine" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">4dp</item>
    </style>
</resources>