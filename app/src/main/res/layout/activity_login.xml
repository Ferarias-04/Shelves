<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/icy_blue"
    tools:context=".LoginActivity">

    <ImageView
        android:id="@+id/imglogin"
        android:layout_width="300dp"
        android:layout_height="280dp"
        android:contentDescription="@string/login_imagen"
        android:scaleType="centerCrop"
        android:src="@mipmap/fondo_login"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/imgLogo"
        android:layout_width="250dp"
        android:layout_height="wrap_content"
        android:layout_margin="12dp"
        android:adjustViewBounds="true"
        android:contentDescription="@string/logo"
        android:scaleType="fitCenter"
        android:src="@drawable/logo_shelves"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/imglogin" />

    <TextView
        android:id="@+id/textIntro"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:maxWidth="250dp"
        android:text="@string/login_descripcion"
        android:textAlignment="center"
        android:textColor="@color/midnight_violet"
        android:textSize="14sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/imgLogo" />

    <LinearLayout
        android:layout_width="250dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/textIntro">

        <!-- Usuario -->
        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Shelves.TextInputLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="@string/login_user_name"
            android:textColorHint="@color/midnight_violet"
            app:boxBackgroundColor="@color/white"
            app:boxStrokeColor="@color/midnight_violet"
            app:endIconMode="clear_text"
            app:endIconTint="@color/midnight_violet"
            app:expandedHintEnabled="false"
            app:placeholderText="@string/login_user_name"
            app:placeholderTextColor="#6B5560">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etUsuario"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:autofillHints="username"
                android:inputType="text"
                android:textColor="@color/midnight_violet"
                android:textColorHint="#6B5560"
                tools:targetApi="o" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Contraseña -->
        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Shelves.TextInputLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="@string/login_contrasena"
            android:textColorHint="@color/midnight_violet"
            app:boxBackgroundColor="@color/white"
            app:boxStrokeColor="@color/midnight_violet"
            app:endIconMode="password_toggle"
            app:endIconTint="@color/midnight_violet"
            app:expandedHintEnabled="false"
            app:placeholderText="@string/login_contrasena"
            app:placeholderTextColor="#6B5560">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etContrasena"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:autofillHints="password"
                android:inputType="textPassword"
                android:textColor="@color/midnight_violet"
                android:textColorHint="@color/midnight_violet"
                tools:ignore="TextContrastCheck"
                tools:targetApi="o" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLogin"
            style="@style/Widget.Shelves.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:text="@string/login_login" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSignUp"
            style="@style/Widget.Shelves.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="@color/white"
            android:text="@string/login_sign_up"
            android:textColor="@color/midnight_violet" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>