<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:paddingBottom="100dp"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp">

        <!-- ===================== FOTO + DATOS DEL USUARIO ===================== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="100dp"
                android:layout_height="88dp"
                app:cardBackgroundColor="#D9D9D9"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp">

                <ImageView
                    android:id="@+id/imgAvatar"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@string/fg_user_foto_de_perfil"
                    android:scaleType="centerCrop" />
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/txtUserName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:text="@string/fg_user_nombreUser"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtBio"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="monospace"
                    android:text="@string/fg_user_descripcion_user"
                    android:textSize="11sp" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnEdit"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="28dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:paddingStart="18dp"
                        android:paddingEnd="18dp"
                        android:text="@string/fg_user_editar"
                        android:textSize="11sp"
                        app:cornerRadius="14dp"
                        app:strokeColor="@color/midnight_violet" />

                    <TextView
                        android:id="@+id/txtFollowing"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:text="@string/fg_user_ver_seguidos"
                        android:textSize="11sp"
                        android:textStyle="italic" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- ===================== TARJETA DE RACHA (versión compacta, sin botones) ===================== -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardBackgroundColor="@color/white"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/midnight_violet"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="14dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:contentDescription="@string/fg_user__icono_racha"
                            android:src="@drawable/llama" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="2dp"
                            android:fontFamily="serif"
                            android:text="@string/fg_home_3"
                            android:textSize="30sp"
                            android:textStyle="bold" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/fg_home_dias_de_racha"
                                android:textSize="11sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/fg_home_top_racha"
                                android:textColor="#9E9E9E"
                                android:textSize="11sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Días de la semana: oscuros = leído, claros = pendiente -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="horizontal">

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="26dp"
                            android:layout_height="26dp"
                            android:layout_marginEnd="5dp"
                            app:cardBackgroundColor="@color/midnight_violet"
                            app:cardCornerRadius="13dp"
                            app:cardElevation="0dp">
                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:gravity="center"
                                android:text="@string/fg_home_lunes"
                                android:textColor="@color/icy_blue"
                                android:textSize="11sp"
                                android:textStyle="bold" />
                        </com.google.android.material.card.MaterialCardView>

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="26dp"
                            android:layout_height="26dp"
                            android:layout_marginEnd="5dp"
                            app:cardBackgroundColor="@color/midnight_violet"
                            app:cardCornerRadius="13dp"
                            app:cardElevation="0dp">
                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:gravity="center"
                                android:text="@string/fg_home_martes"
                                android:textColor="@color/icy_blue"
                                android:textSize="11sp"
                                android:textStyle="bold" />
                        </com.google.android.material.card.MaterialCardView>

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="26dp"
                            android:layout_height="26dp"
                            android:layout_marginEnd="5dp"
                            app:cardBackgroundColor="@color/midnight_violet"
                            app:cardCornerRadius="13dp"
                            app:cardElevation="0dp">
                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:gravity="center"
                                android:text="@string/fg_home_miercoles"
                                android:textColor="@color/icy_blue"
                                android:textSize="11sp"
                                android:textStyle="bold" />
                        </com.google.android.material.card.MaterialCardView>

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="26dp"
                            android:layout_height="26dp"
                            android:layout_marginEnd="5dp"
                            app:cardBackgroundColor="@color/crema"
                            app:cardCornerRadius="13dp"
                            app:cardElevation="0dp">
                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:gravity="center"
                                android:text="@string/fg_home_jueves"
                                android:textColor="#B0A58F"
                                android:textSize="11sp" />
                        </com.google.android.material.card.MaterialCardView>

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="26dp"
                            android:layout_height="26dp"
                            android:layout_marginEnd="5dp"
                            app:cardBackgroundColor="@color/crema"
                            app:cardCornerRadius="13dp"
                            app:cardElevation="0dp">
                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:gravity="center"
                                android:text="@string/fg_home_viernes"
                                android:textColor="#B0A58F"
                                android:textSize="11sp" />
                        </com.google.android.material.card.MaterialCardView>

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="26dp"
                            android:layout_height="26dp"
                            android:layout_marginEnd="5dp"
                            app:cardBackgroundColor="@color/crema"
                            app:cardCornerRadius="13dp"
                            app:cardElevation="0dp">
                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:gravity="center"
                                android:text="@string/fg_home_sabado"
                                android:textColor="#B0A58F"
                                android:textSize="11sp" />
                        </com.google.android.material.card.MaterialCardView>

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="26dp"
                            android:layout_height="26dp"
                            app:cardBackgroundColor="@color/crema"
                            app:cardCornerRadius="13dp"
                            app:cardElevation="0dp">
                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:gravity="center"
                                android:text="@string/fg_home_domingo"
                                android:textColor="#B0A58F"
                                android:textSize="11sp" />
                        </com.google.android.material.card.MaterialCardView>
                    </LinearLayout>
                </LinearLayout>

                <!-- Libro actual -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <com.google.android.material.imageview.ShapeableImageView
                        android:layout_width="84dp"
                        android:layout_height="54dp"
                        android:contentDescription="@string/fg_home_lectura_actual"
                        android:scaleType="centerCrop"
                        android:src="@mipmap/circe_portada"
                        app:shapeAppearanceOverlay="@style/RoundedCover"  />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/fg_home_lectura_actual"
                        android:textSize="9sp" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ===================== GOAL DE LECTURA ===================== -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:fontFamily="serif"
            android:text="@string/fg_user_goal_de_lectura"
            android:textSize="18sp" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            app:cardBackgroundColor="@color/icy_blue"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="14dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:text="@string/fg_user_libros_año"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/txtGoal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="serif"
                        android:text="@string/fg_user_numeros_libros_año"
                        android:textSize="36sp" />
                </LinearLayout>

                <!-- Lomos de los libros leídos (4) y huecos pendientes (2) -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <com.google.android.material.imageview.ShapeableImageView
                        android:layout_width="20dp"
                        android:layout_height="70dp"
                        android:layout_marginEnd="3dp"
                        android:contentDescription="@string/fg_user_libro_leido"
                        android:scaleType="centerCrop"
                        android:src="@mipmap/circe_portada"
                        app:shapeAppearanceOverlay="@style/RoundedSpine"/>

                    <com.google.android.material.imageview.ShapeableImageView
                        android:layout_width="20dp"
                        android:layout_height="70dp"
                        android:layout_marginEnd="3dp"
                        android:contentDescription="@string/fg_user_libro_leido"
                        android:scaleType="centerCrop"
                        android:src="@mipmap/circe_portada"
                        app:shapeAppearanceOverlay="@style/RoundedSpine"/>

                    <com.google.android.material.imageview.ShapeableImageView
                        android:layout_width="20dp"
                        android:layout_height="70dp"
                        android:layout_marginEnd="3dp"
                        android:contentDescription="@string/fg_user_libro_leido"
                        android:scaleType="centerCrop"
                        android:src="@mipmap/circe_portada"
                        app:shapeAppearanceOverlay="@style/RoundedSpine"/>

                    <com.google.android.material.imageview.ShapeableImageView
                        android:layout_width="20dp"
                        android:layout_height="70dp"
                        android:layout_marginEnd="3dp"
                        android:contentDescription="@string/fg_user_libro_leido"
                        android:scaleType="centerCrop"
                        android:src="@mipmap/circe_portada"
                        app:shapeAppearanceOverlay="@style/RoundedSpine"/>

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="20dp"
                        android:layout_height="70dp"
                        android:layout_marginEnd="3dp"
                        app:cardBackgroundColor="@color/crema"
                        app:cardCornerRadius="6dp"
                        app:cardElevation="0dp" />

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="20dp"
                        android:layout_height="70dp"
                        app:cardBackgroundColor="@color/crema"
                        app:cardCornerRadius="6dp"
                        app:cardElevation="0dp" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ===================== TUS RESEÑAS ===================== -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:fontFamily="serif"
            android:text="@string/fg_user_tus_reseñas"
            android:textSize="18sp" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            app:cardBackgroundColor="@color/white"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/midnight_violet"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:text="@string/fg_user_rango_reseñas"
                    android:textSize="11sp" />

                <!-- 10 columnas. La barra verde (barN) mide lo que valga ese rango.
                     La pista (crema) mide 120dp, así que barN puede ir de 0dp a 120dp. -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <!-- 1 -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center_horizontal"
                        android:orientation="vertical">
                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="14dp"
                            android:layout_height="120dp"
                            app:cardBackgroundColor="@color/crema"
                            app:cardCornerRadius="7dp"
                            app:cardElevation="0dp">
                            <View
                                android:id="@+id/bar1"
                                android:layout_width="match_parent"
                                android:layout_height="30dp"
                                android:layout_gravity="bottom"
                                android:background="@color/verde" />
                        </com.google.android.material.card.MaterialCardView>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:maxLines="1"
                            android:text="@string/fg_user_1_estrella"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <!-- 1,5 -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center_horizontal"
                        android:orientation="vertical">
                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="14dp"
                            android:layout_height="120dp"
                            app:cardBackgroundColor="@color/crema"
                            app:cardCornerRadius="7dp"
                            app:cardElevation="0dp">
                            <View
                                android:id="@+id/bar2"
                                android:layout_width="match_parent"
                                android:layout_height="0dp"
                                android:layout_gravity="bottom"
                                android:background="@color/verde" />
                        </com.google.android.material.card.MaterialCardView>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:maxLines="1"
                            android:text="@string/fg_user_1_5_estrella"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <!-- 2 -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center_horizontal"
                        android:orientation="vertical">
                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="14dp"
                            android:layout_height="120dp"
                            app:cardBackgroundColor="@color/crema"
                            app:cardCornerRadius="7dp"
                            app:cardElevation="0dp">
                            <View
                                android:id="@+id/bar3"
                                android:layout_width="match_parent"
                                android:layout_height="0dp"
                                android:layout_gravity="bottom"
                                android:background="@color/verde" />
                        </com.google.android.material.card.MaterialCardView>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:maxLines="1"
                            android:text="@string/fg_user_2_estrella"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <!-- 2,5 -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center_horizontal"
                        android:orientation="vertical">
                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="14dp"
                            android:layout_height="120dp"
                            app:cardBackgroundColor="@color/crema"
                            app:cardCornerRadius="7dp"
                            app:cardElevation="0dp">
                            <View
                                android:id="@+id/bar4"
                                android:layout_width="match_parent"
                                android:layout_height="30dp"
                                android:layout_gravity="bottom"
                                android:background="@color/verde" />
                        </com.google.android.material.card.MaterialCardView>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:maxLines="1"
                            android:text="@string/fg_user_2_5_estrellas"
                            android:textSize="8sp" />
                    </LinearLayout>

                    <!-- 3 -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center_horizontal"
                        android:orientation="vertical">
                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="14dp"
                            android:layout_height="120dp"
                            app:cardBackgroundColor="@color/crema"
                            app:cardCornerRadius="7dp"
                            app:cardElevation="0dp">
                            <View
                                android:id="@+id/bar5"
                                android:layout_width="match_parent"
                                android:layout_height="90dp"
                                android:layout_gravity="bottom"
                                android:background="@color/verde" />
                        </com.google.android.material.card.MaterialCardView>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:maxLines="1"
                            android:text="@string/fg_user_3_estrella"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <!-- 3,5 -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center_horizontal"
                        android:orientation="vertical">
                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="14dp"
                            android:layout_height="120dp"
                            app:cardBackgroundColor="@color/crema"
                            app:cardCornerRadius="7dp"
                            app:cardElevation="0dp">
                            <View
                                android:id="@+id/bar6"
                                android:layout_width="match_parent"
                                android:layout_height="55dp"
                                android:layout_gravity="bottom"
                                android:background="@color/verde" />
                        </com.google.android.material.card.MaterialCardView>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:maxLines="1"
                            android:text="@string/fg_user_3_5_estrellas"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <!-- 4 -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center_horizontal"
                        android:orientation="vertical">
                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="14dp"
                            android:layout_height="120dp"
                            app:cardBackgroundColor="@color/crema"
                            app:cardCornerRadius="7dp"
                            app:cardElevation="0dp">
                            <View
                                android:id="@+id/bar7"
                                android:layout_width="match_parent"
                                android:layout_height="100dp"
                                android:layout_gravity="bottom"
                                android:background="@color/verde" />
                        </com.google.android.material.card.MaterialCardView>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:maxLines="1"
                            android:text="@string/fg_user_4_estrella"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <!-- 4,5 -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center_horizontal"
                        android:orientation="vertical">
                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="14dp"
                            android:layout_height="120dp"
                            app:cardBackgroundColor="@color/crema"
                            app:cardCornerRadius="7dp"
                            app:cardElevation="0dp">
                            <View
                                android:id="@+id/bar8"
                                android:layout_width="match_parent"
                                android:layout_height="0dp"
                                android:layout_gravity="bottom"
                                android:background="@color/verde" />
                        </com.google.android.material.card.MaterialCardView>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:maxLines="1"
                            android:text="@string/fg_user_4_5_estrellas"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <!-- 5 -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center_horizontal"
                        android:orientation="vertical">
                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="14dp"
                            android:layout_height="120dp"
                            app:cardBackgroundColor="@color/crema"
                            app:cardCornerRadius="7dp"
                            app:cardElevation="0dp">
                            <View
                                android:id="@+id/bar9"
                                android:layout_width="match_parent"
                                android:layout_height="0dp"
                                android:layout_gravity="bottom"
                                android:background="@color/verde" />
                        </com.google.android.material.card.MaterialCardView>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:maxLines="1"
                            android:text="@string/fg_user_5_estrella"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <!-- 6 -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center_horizontal"
                        android:orientation="vertical">
                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="14dp"
                            android:layout_height="120dp"
                            app:cardBackgroundColor="@color/crema"
                            app:cardCornerRadius="7dp"
                            app:cardElevation="0dp">
