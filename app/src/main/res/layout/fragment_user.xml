<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:paddingBottom="100dp"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="8dp"
        android:paddingEnd="20dp">

        <!-- foto + datos del usuario -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="100dp"
                android:layout_height="88dp"
                app:cardBackgroundColor="@color/gris_portada"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp">

                <ImageView
                    android:id="@+id/imgAvatar"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    android:importantForAccessibility="no"
                    android:scaleType="centerCrop"
                    tools:ignore="ImageContrastCheck" />
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/txtUserName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:text="@string/fg_user_nombreUser"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtBio"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="monospace"
                    android:text="@string/fg_user_descripcion_user"
                    android:textSize="11sp" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <!-- Se ve de 28dp pero se toca en 48dp gracias a los insets -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnEdit"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:insetTop="10dp"
                        android:insetBottom="10dp"
                        android:minWidth="48dp"
                        android:minHeight="48dp"
                        android:paddingStart="18dp"
                        android:paddingEnd="18dp"
                        android:text="@string/fg_user_editar"
                        android:textSize="11sp"
                        app:cornerRadius="14dp"
                        app:strokeColor="@color/midnight_violet" />

                    <TextView
                        android:id="@+id/txtFollowing"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:text="@string/fg_user_ver_seguidos"
                        android:textSize="11sp"
                        android:textStyle="italic" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- tarjeta de racha (versión compacta, sin botones) -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardBackgroundColor="@color/white"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/midnight_violet"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="14dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:contentDescription="@string/fg_user__icono_racha"
                            android:src="@drawable/llama" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="2dp"
                            android:fontFamily="serif"
                            android:text="@string/fg_home_3"
                            android:textSize="30sp"
                            android:textStyle="bold" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/fg_home_dias_de_racha"
                                android:textSize="11sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/fg_home_top_racha"
                                android:textColor="#6B5560"
                                android:textSize="11sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Días de la semana: oscuros = leído, claros = pendiente -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="26dp"
                            android:layout_height="26dp"
                            android:layout_marginEnd="5dp"
                            android:background="@drawable/bg_dia_leido"
                            android:gravity="center"
                            android:text="@string/fg_home_lunes"
                            android:textColor="@color/icy_blue"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="26dp"
                            android:layout_height="26dp"
                            android:layout_marginEnd="5dp"
                            android:background="@drawable/bg_dia_leido"
                            android:gravity="center"
                            android:text="@string/fg_home_martes"
                            android:textColor="@color/icy_blue"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="26dp"
                            android:layout_height="26dp"
                            android:layout_marginEnd="5dp"
                            android:background="@drawable/bg_dia_leido"
                            android:gravity="center"
                            android:text="@string/fg_home_miercoles"
                            android:textColor="@color/icy_blue"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="26dp"
                            android:layout_height="26dp"
                            android:layout_marginEnd="5dp"
                            android:background="@drawable/bg_dia_pendiente"
                            android:gravity="center"
                            android:text="@string/fg_home_jueves"
                            android:textColor="#6B5560"
                            android:textSize="11sp" />

                        <TextView
                            android:layout_width="26dp"
                            android:layout_height="26dp"
                            android:layout_marginEnd="5dp"
                            android:background="@drawable/bg_dia_pendiente"
                            android:gravity="center"
                            android:text="@string/fg_home_viernes"
                            android:textColor="#6B5560"
                            android:textSize="11sp" />

                        <TextView
                            android:layout_width="26dp"
                            android:layout_height="26dp"
                            android:layout_marginEnd="5dp"
                            android:background="@drawable/bg_dia_pendiente"
                            android:gravity="center"
                            android:text="@string/fg_home_sabado"
                            android:textColor="#6B5560"
                            android:textSize="11sp" />

                        <TextView
                            android:layout_width="26dp"
                            android:layout_height="26dp"
                            android:background="@drawable/bg_dia_pendiente"
                            android:gravity="center"
                            android:text="@string/fg_home_domingo"
                            android:textColor="#6B5560"
                            android:textSize="11sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Libro actual -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <com.google.android.material.imageview.ShapeableImageView
                        android:layout_width="84dp"
                        android:layout_height="54dp"
                        android:contentDescription="@string/fg_home_lectura_actual"
                        android:scaleType="centerCrop"
                        android:src="@mipmap/circe_portada"
                        app:shapeAppearanceOverlay="@style/RoundedCover" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/fg_home_lectura_actual"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- goal de lectura -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:fontFamily="serif"
            android:text="@string/fg_user_goal_de_lectura"
            android:textSize="18sp" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            app:cardBackgroundColor="@color/icy_blue"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="14dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:text="@string/fg_user_libros_año"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/txtGoal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="serif"
                        android:text="@string/fg_user_numeros_libros_año"
                        android:textSize="36sp" />
                </LinearLayout>

                <!-- Lomos de los libros leídos (4) y huecos pendientes (2) -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <com.google.android.material.imageview.ShapeableImageView
                        android:layout_width="20dp"
                        android:layout_height="70dp"
                        android:layout_marginEnd="3dp"
                        android:contentDescription="@string/fg_user_libro_leido"
                        android:scaleType="centerCrop"
                        android:src="@mipmap/circe_portada"
                        app:shapeAppearanceOverlay="@style/RoundedSpine" />

                    <com.google.android.material.imageview.ShapeableImageView
                        android:layout_width="20dp"
                        android:layout_height="70dp"
                        android:layout_marginEnd="3dp"
                        android:contentDescription="@string/fg_user_libro_leido"
                        android:scaleType="centerCrop"
                        android:src="@mipmap/circe_portada"
                        app:shapeAppearanceOverlay="@style/RoundedSpine" />

                    <com.google.android.material.imageview.ShapeableImageView
                        android:layout_width="20dp"
                        android:layout_height="70dp"
                        android:layout_marginEnd="3dp"
                        android:contentDescription="@string/fg_user_libro_leido"
                        android:scaleType="centerCrop"
                        android:src="@mipmap/circe_portada"
                        app:shapeAppearanceOverlay="@style/RoundedSpine" />

                    <com.google.android.material.imageview.ShapeableImageView
                        android:layout_width="20dp"
                        android:layout_height="70dp"
                        android:layout_marginEnd="3dp"
                        android:contentDescription="@string/fg_user_libro_leido"
                        android:scaleType="centerCrop"
                        android:src="@mipmap/circe_portada"
                        app:shapeAppearanceOverlay="@style/RoundedSpine" />

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="20dp"
                        android:layout_height="70dp"
                        android:layout_marginEnd="3dp"
                        app:cardBackgroundColor="@color/crema"
                        app:cardCornerRadius="6dp"
                        app:cardElevation="0dp" />

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="20dp"
                        android:layout_height="70dp"
                        app:cardBackgroundColor="@color/crema"
                        app:cardCornerRadius="6dp"
                        app:cardElevation="0dp" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- tus reseñas -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:fontFamily="serif"
            android:text="@string/fg_user_tus_reseñas"
            android:textSize="18sp" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            app:cardBackgroundColor="@color/white"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/midnight_violet"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:text="@string/fg_user_rango_reseñas"
                    android:textSize="11sp" />

                <!-- 10 columnas. Cada barra és un ProgressBar vertical:
                     android:progress va de 0 a 120 (antes era la altura en dp). -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <!-- 1 -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center_horizontal"
                        android:orientation="vertical">
                        <ProgressBar
                            android:id="@+id/bar1"
                            style="?android:attr/progressBarStyleHorizontal"
                            android:layout_width="14dp"
                            android:layout_height="120dp"
                            android:max="120"
                            android:maxHeight="120dp"
                            android:minHeight="120dp"
                            android:progress="30"
                            android:progressDrawable="@drawable/barra_resena" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:maxLines="1"
                            android:text="@string/fg_user_1_estrella"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <!-- 1,5 -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center_horizontal"
                        android:orientation="vertical">
                        <ProgressBar
                            android:id="@+id/bar2"
                            style="?android:attr/progressBarStyleHorizontal"
                            android:layout_width="14dp"
                            android:layout_height="120dp"
                            android:max="120"
                            android:maxHeight="120dp"
                            android:minHeight="120dp"
                            android:progress="0"
                            android:progressDrawable="@drawable/barra_resena" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:maxLines="1"
                            android:text="@string/fg_user_1_5_estrella"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <!-- 2 -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center_horizontal"
                        android:orientation="vertical">
                        <ProgressBar
                            android:id="@+id/bar3"
                            style="?android:attr/progressBarStyleHorizontal"
                            android:layout_width="14dp"
                            android:layout_height="120dp"
                            android:max="120"
                            android:maxHeight="120dp"
                            android:minHeight="120dp"
                            android:progress="0"
                            android:progressDrawable="@drawable/barra_resena" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:maxLines="1"
                            android:text="@string/fg_user_2_estrella"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <!-- 2,5 -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center_horizontal"
                        android:orientation="vertical">
                        <ProgressBar
                            android:id="@+id/bar4"
                            style="?android:attr/progressBarStyleHorizontal"
                            android:layout_width="14dp"
                            android:layout_height="120dp"
                            android:max="120"
                            android:maxHeight="120dp"
                            android:minHeight="120dp"
                            android:progress="30"
                            android:progressDrawable="@drawable/barra_resena" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:maxLines="1"
                            android:text="@string/fg_user_2_5_estrellas"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <!-- 3 -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center_horizontal"
                        android:orientation="vertical">
                        <ProgressBar
                            android:id="@+id/bar5"
                            style="?android:attr/progressBarStyleHorizontal"
                            android:layout_width="14dp"
                            android:layout_height="120dp"
                            android:max="120"
                            android:maxHeight="120dp"
                            android:minHeight="120dp"
                            android:progress="90"
                            android:progressDrawable="@drawable/barra_resena" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:maxLines="1"
                            android:text="@string/fg_user_3_estrella"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <!-- 3,5 -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center_horizontal"
                        android:orientation="vertical">
                        <ProgressBar
                            android:id="@+id/bar6"
                            style="?android:attr/progressBarStyleHorizontal"
                            android:layout_width="14dp"
                            android:layout_height="120dp"
                            android:max="120"
                            android:maxHeight="120dp"
                            android:minHeight="120dp"
                            android:progress="55"
                            android:progressDrawable="@drawable/barra_resena" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:maxLines="1"
                            android:text="@string/fg_user_3_5_estrellas"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <!-- 4 -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center_horizontal"
                        android:orientation="vertical">
                        <ProgressBar
                            android:id="@+id/bar7"
                            style="?android:attr/progressBarStyleHorizontal"
                            android:layout_width="14dp"
                            android:layout_height="120dp"
                            android:max="120"
                            android:maxHeight="120dp"
                            android:minHeight="120dp"
                            android:progress="100"
                            android:progressDrawable="@drawable/barra_resena" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:maxLines="1"
                            android:text="@string/fg_user_4_estrella"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <!-- 4,5 -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center_horizontal"
                        android:orientation="vertical">
                        <ProgressBar
                            android:id="@+id/bar8"
                            style="?android:attr/progressBarStyleHorizontal"
                            android:layout_width="14dp"
                            android:layout_height="120dp"
                            android:max="120"
                            android:maxHeight="120dp"
                            android:minHeight="120dp"
                            android:progress="0"
                            android:progressDrawable="@drawable/barra_resena" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:maxLines="1"
                            android:text="@string/fg_user_4_5_estrellas"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <!-- 5 -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center_horizontal"
                        android:orientation="vertical">
                        <ProgressBar
                            android:id="@+id/bar9"
                            style="?android:attr/progressBarStyleHorizontal"
                            android:layout_width="14dp"
                            android:layout_height="120dp"
                            android:max="120"
                            android:maxHeight="120dp"
                            android:minHeight="120dp"
                            android:progress="0"
                            android:progressDrawable="@drawable/barra_resena" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:maxLines="1"
                            android:text="@string/fg_user_5_estrella"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <!-- 6 -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center_horizontal"
                        android:orientation="vertical">
                        <ProgressBar
                            android:id="@+id/bar10"
                            style="?android:attr/progressBarStyleHorizontal"
                            android:layout_width="14dp"
                            android:layout_height="120dp"
                            android:max="120"
                            android:maxHeight="120dp"
                            android:minHeight="120dp"
                            android:progress="45"
                            android:progressDrawable="@drawable/barra_resena" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:maxLines="1"
                            android:text="@string/fg_user_6_estrella"
                            android:textSize="11sp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>