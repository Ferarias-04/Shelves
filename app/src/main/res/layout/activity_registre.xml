<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/icy_blue"
    tools:context=".RegistreActivity">

    <!-- Cabecera: nubes + logo -->
    <FrameLayout
        android:id="@+id/logo"
        android:layout_width="0dp"
        android:layout_height="130dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Nube izquierda (se sale del borde a propósito) -->
        <ImageView
            android:layout_width="90dp"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:layout_marginTop="16dp"
            android:adjustViewBounds="true"
            android:contentDescription="@null"
            android:importantForAccessibility="no"
            android:src="@drawable/nube"
            android:translationX="-20dp"
            tools:ignore="ImageContrastCheck" />

        <!-- Nube derecha (se sale del borde a propósito) -->
        <ImageView
            android:layout_width="110dp"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_marginTop="60dp"
            android:adjustViewBounds="true"
            android:contentDescription="@null"
            android:importantForAccessibility="no"
            android:src="@drawable/nube"
            android:translationX="30dp"
            tools:ignore="ImageContrastCheck" />

        <!-- Logo, al final para que quede encima -->
        <ImageView
            android:layout_width="250dp"
            android:layout_height="wrap_content"
            android:layout_gravity="top|center_horizontal"
            android:layout_marginTop="50dp"
            android:adjustViewBounds="true"
            android:contentDescription="@string/logo"
            android:src="@drawable/logo_shelves" />
    </FrameLayout>

    <!-- Formulario con scroll (para cuando se abre el teclado) -->
    <ScrollView
        android:id="@+id/scrollFormulario"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingBottom="24dp"
        android:scrollbars="none"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/logo">

        <LinearLayout
            android:id="@+id/formulario"
            android:layout_width="250dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:orientation="vertical">

            <!-- Nombre de usuario -->
            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Shelves.TextInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="@string/login_user_name"
                android:textColorHint="@color/midnight_violet"
                app:boxBackgroundColor="@color/white"
                app:boxStrokeColor="@color/midnight_violet"
                app:endIconMode="clear_text"
                app:endIconTint="@color/midnight_violet"
                app:expandedHintEnabled="false"
                app:placeholderText="@string/login_user_name"
                app:placeholderTextColor="#6B5560">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etRegUsuario"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:autofillHints="username"
                    android:inputType="text"
                    android:textColor="@color/midnight_violet"
                    android:textColorHint="#6B5560"
                    tools:ignore="TextContrastCheck"
                    tools:targetApi="o" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Nombre -->
            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Shelves.TextInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="@string/registre_name"
                android:textColorHint="@color/midnight_violet"
                app:boxBackgroundColor="@color/white"
                app:boxStrokeColor="@color/midnight_violet"
                app:endIconMode="clear_text"
                app:endIconTint="@color/midnight_violet"
                app:expandedHintEnabled="false"
                app:placeholderText="@string/registre_name"
                app:placeholderTextColor="#6B5560">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etRegNombre"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:autofillHints="personGivenName"
                    android:inputType="textPersonName|textCapWords"
                    android:textColor="@color/midnight_violet"
                    android:textColorHint="#6B5560"
                    tools:ignore="TextContrastCheck"
                    tools:targetApi="o" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Apellido -->
            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Shelves.TextInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="@string/registre_apellido"
                android:textColorHint="@color/midnight_violet"
                app:boxBackgroundColor="@color/white"
                app:boxStrokeColor="@color/midnight_violet"
                app:endIconMode="clear_text"
                app:endIconTint="@color/midnight_violet"
                app:expandedHintEnabled="false"
                app:placeholderText="@string/registre_apellido"
                app:placeholderTextColor="#6B5560">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etRegApellido"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:autofillHints="personFamilyName"
                    android:inputType="textPersonName|textCapWords"
                    android:textColor="@color/midnight_violet"
                    android:textColorHint="#6B5560"
                    tools:ignore="TextContrastCheck"
                    tools:targetApi="o" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Email -->
            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Shelves.TextInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="@string/registre_email"
                android:textColorHint="@color/midnight_violet"
                app:boxBackgroundColor="@color/white"
                app:boxStrokeColor="@color/midnight_violet"
                app:endIconMode="clear_text"
                app:endIconTint="@color/midnight_violet"
                app:expandedHintEnabled="false"
                app:placeholderText="@string/registre_email_ejemplo"
                app:placeholderTextColor="#6B5560">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etRegEmail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:autofillHints="emailAddress"
                    android:inputType="textEmailAddress"
                    android:textColor="@color/midnight_violet"
                    android:textColorHint="#6B5560"
                    tools:ignore="TextContrastCheck"
                    tools:targetApi="o" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Contraseña -->
            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Shelves.TextInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="@string/login_contrasena"
                android:textColorHint="@color/midnight_violet"
                app:boxBackgroundColor="@color/white"
                app:boxStrokeColor="@color/midnight_violet"
                app:endIconMode="password_toggle"
                app:endIconTint="@color/midnight_violet">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etRegContrasena"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:autofillHints="newPassword"
                    android:inputType="textPassword"
                    android:textColor="@color/midnight_violet"
                    android:textColorHint="@color/midnight_violet"
                    tools:ignore="TextContrastCheck"
                    tools:targetApi="o" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Confirmar contraseña -->
            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Shelves.TextInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="@string/registre_confirma_contrasena"
                android:textColorHint="@color/midnight_violet"
                app:boxBackgroundColor="@color/white"
                app:boxStrokeColor="@color/midnight_violet"
                app:endIconMode="password_toggle"
                app:endIconTint="@color/midnight_violet">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etRegConfirmar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:autofillHints="newPassword"
                    android:inputType="textPassword"
                    android:textColor="@color/midnight_violet"
                    android:textColorHint="@color/midnight_violet"
                    tools:ignore="TextContrastCheck"
                    tools:targetApi="o" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRegistro"
                style="@style/Widget.Shelves.Button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:text="@string/registre_get_started" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnVolverLogin"
                style="@style/Widget.Shelves.Button.Text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/registre_volver_a_login"
                android:textColor="@color/midnight_violet"
                android:textSize="13sp" />
        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>