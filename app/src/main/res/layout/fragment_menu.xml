<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/icy_blue"
    android:clickable="true"
    android:focusable="true">

    <!-- Botón para cerrar el menú (arriba a la izquierda) -->
    <ImageView
        android:id="@+id/btnCloseMenu"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="24dp"
        android:layout_marginTop="40dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:contentDescription="@string/menu"
        android:focusable="true"
        android:padding="4dp"
        android:src="@drawable/menu_active"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Contenido centrado -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.4">

        <!-- Modo oscuro -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/btnDarkMode"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:clickable="true"
            android:focusable="true"
            app:cardBackgroundColor="@color/white"
            app:cardCornerRadius="14dp"
            app:cardElevation="4dp">

            <ImageView
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_gravity="center"
                android:contentDescription="@string/fg_menu_modo_noche"
                android:src="@drawable/modo_noche" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Preferencias -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPreferences"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="180dp"
            android:layout_height="44dp"
            android:layout_marginTop="20dp"
            android:backgroundTint="@color/white"
            android:fontFamily="serif"
            android:text="@string/fg_menu_preferencias"
            android:textColor="@color/black"
            android:textSize="14sp"
            app:cornerRadius="14dp"
            app:strokeColor="@color/midnight_violet" />

        <!-- Ayuda -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnHelp"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="180dp"
            android:layout_height="44dp"
            android:layout_marginTop="12dp"
            android:backgroundTint="@color/white"
            android:fontFamily="serif"
            android:text="@string/fg_menu_ayuda"
            android:textColor="@color/black"
            android:textSize="14sp"
            app:cornerRadius="14dp"
            app:strokeColor="@color/midnight_violet" />

        <!-- Contacto -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:fontFamily="monospace"
            android:text="@string/fg_menu_escribenos"
            android:textColor="@color/black"
            android:textSize="11sp"
            android:textStyle="italic" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/btnInstagram"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:contentDescription="@string/fg_menu_instagram"
                android:focusable="true"
                android:padding="3dp"
                android:src="#524848"/>

            <ImageView
                android:id="@+id/btnThreads"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="20dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:contentDescription="@string/fg_menu_threads"
                android:focusable="true"
                android:padding="3dp"
                android:src="#665858" />

            <ImageView
                android:id="@+id/btnEmail"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="20dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:contentDescription="@string/fg_menu_email"
                android:focusable="true"
                android:padding="3dp"
                android:src="@drawable/mail" />
        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>