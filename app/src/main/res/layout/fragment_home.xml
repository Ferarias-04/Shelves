<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:paddingBottom="100dp"
    android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp">

            <!-- Saludo + avatar -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="serif"
                        android:text="@string/fg_home_bienvenida"
                        android:textSize="18sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/fg_home_fecha"
                        android:textColor="#9E9E9E"
                        android:textSize="11sp" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/imgAvatar"
                    android:layout_width="72dp"
                    android:layout_height="52dp"
                    android:background="#D9D9D9"
                    android:contentDescription="@string/fg_home_avatar"
                    android:scaleType="centerCrop" />
            </LinearLayout>

            <!--  TARJETA DE RACHA (pasar a StreakCardFragment) -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/midnight_violet"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="14dp">

                    <!-- Columna izquierda -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="serif"
                            android:text="@string/fg_home_lectura_hoy"
                            android:textSize="16sp" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:contentDescription="@string/fg_home_racha"
                                android:src="@drawable/llama" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="2dp"
                                android:text="@string/fg_home_3"
                                android:textSize="30sp"
                                android:textStyle="bold" />

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="6dp"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/fg_home_dias_de_racha"
                                    android:textSize="11sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/fg_home_top_racha"
                                    android:textColor="#9E9E9E"
                                    android:textSize="11sp" />
                            </LinearLayout>
                        </LinearLayout>

                        <!-- Días de la semana: oscuros = leído, claros = pendiente -->
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:orientation="horizontal">

                            <com.google.android.material.card.MaterialCardView
                                android:layout_width="26dp"
                                android:layout_height="26dp"
                                android:layout_marginEnd="5dp"
                                app:cardCornerRadius="13dp"
                                app:cardElevation="0dp"
                                android:backgroundTint="@color/midnight_violet"
                                >
                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:gravity="center"
                                    android:text="@string/fg_home_lunes"
                                    android:textColor="@color/icy_blue"
                                    android:textSize="11sp"
                                    android:textStyle="bold" />
                            </com.google.android.material.card.MaterialCardView>

                            <com.google.android.material.card.MaterialCardView
                                android:layout_width="26dp"
                                android:layout_height="26dp"
                                android:layout_marginEnd="5dp"
                                app:cardBackgroundColor="@color/midnight_violet"
                                app:cardCornerRadius="13dp"
                                app:cardElevation="0dp">
                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:gravity="center"
                                    android:text="@string/fg_home_martes"
                                    android:textColor="@color/icy_blue"
                                    android:textSize="11sp"
                                    android:textStyle="bold" />
                            </com.google.android.material.card.MaterialCardView>

                            <com.google.android.material.card.MaterialCardView
                                android:layout_width="26dp"
                                android:layout_height="26dp"
                                android:layout_marginEnd="5dp"
                                app:cardBackgroundColor="@color/midnight_violet"
                                app:cardCornerRadius="13dp"
                                app:cardElevation="0dp">
                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:gravity="center"
                                    android:text="@string/fg_home_miercoles"
                                    android:textColor="@color/icy_blue"
                                    android:textSize="11sp"
                                    android:textStyle="bold" />
                            </com.google.android.material.card.MaterialCardView>

                            <com.google.android.material.card.MaterialCardView
                                android:layout_width="26dp"
                                android:layout_height="26dp"
                                android:layout_marginEnd="5dp"
                                app:cardBackgroundColor="@color/crema"
                                app:cardCornerRadius="13dp"
                                app:cardElevation="0dp">
                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:gravity="center"
                                    android:text="@string/fg_home_jueves"
                                    android:textColor="#B0A58F"
                                    android:textSize="11sp" />
                            </com.google.android.material.card.MaterialCardView>

                            <com.google.android.material.card.MaterialCardView
                                android:layout_width="26dp"
                                android:layout_height="26dp"
                                android:layout_marginEnd="5dp"
                                app:cardBackgroundColor="@color/crema"
                                app:cardCornerRadius="13dp"
                                app:cardElevation="0dp">
                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:gravity="center"
                                    android:text="@string/fg_home_viernes"
                                    android:textColor="#B0A58F"
                                    android:textSize="11sp" />
                            </com.google.android.material.card.MaterialCardView>

                            <com.google.android.material.card.MaterialCardView
                                android:layout_width="26dp"
                                android:layout_height="26dp"
                                android:layout_marginEnd="5dp"
                                app:cardBackgroundColor="@color/crema"
                                app:cardCornerRadius="13dp"
                                app:cardElevation="0dp">
                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:gravity="center"
                                    android:text="@string/fg_home_sabado"
                                    android:textColor="#B0A58F"
                                    android:textSize="11sp" />
                            </com.google.android.material.card.MaterialCardView>

                            <com.google.android.material.card.MaterialCardView
                                android:layout_width="26dp"
                                android:layout_height="26dp"
                                app:cardBackgroundColor="@color/crema"
                                app:cardCornerRadius="13dp"
                                app:cardElevation="0dp">
                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:gravity="center"
                                    android:text="@string/fg_home_domingo"
                                    android:textColor="#B0A58F"
                                    android:textSize="11sp" />
                            </com.google.android.material.card.MaterialCardView>
                        </LinearLayout>

                        <!-- Botones (en la versión compacta del Perfil esta fila se oculta) -->
                        <LinearLayout
                            android:id="@+id/buttonsRow"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:orientation="horizontal">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnReadToday"
                                style="@style/Widget.Material3.Button.OutlinedButton"
                                android:layout_width="wrap_content"
                                android:layout_height="32dp"
                                android:insetTop="0dp"
                                android:insetBottom="0dp"
                                android:minHeight="0dp"
                                android:paddingStart="14dp"
                                android:paddingEnd="14dp"
                                android:text="@string/fg_home_afirma_leer"
                                android:textSize="11sp"
                                android:backgroundTint="@color/crema"
                                app:strokeColor="@color/midnight_violet" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnMore"
                                style="@style/Widget.Material3.Button.OutlinedButton"
                                android:layout_width="55dp"
                                android:layout_height="32dp"
                                android:layout_marginStart="6dp"
                                android:insetTop="0dp"
                                android:insetBottom="0dp"
                                android:minHeight="0dp"
                                android:minWidth="0dp"
                                android:paddingStart="12dp"
                                android:paddingEnd="12dp"
                                android:text="@string/fg_home_opciones_lectura"
                                android:textSize="11sp"
                                android:backgroundTint="@color/crema"
                                app:strokeColor="@color/midnight_violet" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Columna derecha: libro actual -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        >

                        <ImageView
                            android:layout_width="84dp"
                            android:layout_height="120dp"
                            android:contentDescription="@string/fg_home_lectura_actual"
                            android:scaleType="centerCrop"
                            android:src="@mipmap/circe_portada"
                            />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="@string/fg_home_lectura_actual"
                            android:textSize="11sp" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ===================== FRASE DEL MES ===================== -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:fontFamily="serif"
                android:text="@string/fg_home_frase_del_mes"
                android:textSize="18sp" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                app:cardBackgroundColor="@color/icy_blue"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/midnight_violet"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/fg_home_lectura_del_mes"
                        android:textSize="12sp"
                        android:textColor="@color/black"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:gravity="end"
                        android:text="@string/fg_home_escritora_del_mes"
                        android:textColor="#7A7A9A"
                        android:textSize="11sp"
                        android:textStyle="italic" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnDiscoverBook"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:layout_marginTop="6dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:minHeight="0dp"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:text="@string/fg_home_descubre_el_libro"
                        android:textSize="11sp"
                        android:backgroundTint="@color/crema"
                        app:strokeColor="@color/midnight_violet" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ===================== LIBROS MÁS LEÍDOS ===================== -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:fontFamily="serif"
                android:text="@string/fg_home_libros_top_mes"
                android:textSize="18sp" />

            <!-- Filtros por género -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:scrollbars="none">

                <com.google.android.material.chip.ChipGroup
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:selectionRequired="true"
                    app:singleLine="true"
                    app:singleSelection="true">

                    <com.google.android.material.chip.Chip
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:text="@string/fg_home_genero_general" />

                    <com.google.android.material.chip.Chip
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/fg_home_genero_terror" />

                    <com.google.android.material.chip.Chip
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/fg_home_genero_romance" />

                    <com.google.android.material.chip.Chip
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/fg_home_genero_fantasia" />

                    <com.google.android.material.chip.Chip
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/fg_home_genero_distopia" />
                </com.google.android.material.chip.ChipGroup>
            </HorizontalScrollView>

            <!-- Portadas (3 fijas; luego se puede pasar a RecyclerView horizontal) -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <com.google.android.material.imageview.ShapeableImageView
                        android:layout_width="110dp"
                        android:layout_height="160dp"
                        android:layout_marginEnd="12dp"
                        android:contentDescription="@string/fg_home_portada"
                        android:scaleType="centerCrop"
                        android:src="@mipmap/circe_portada"
                        app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Small" />

                    <com.google.android.material.imageview.ShapeableImageView
                        android:layout_width="110dp"
                        android:layout_height="160dp"
                        android:layout_marginEnd="12dp"
                        android:contentDescription="@string/fg_home_portada"
                        android:scaleType="centerCrop"
                        android:src="@mipmap/circe_portada"
                        app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Small" />

                    <com.google.android.material.imageview.ShapeableImageView
                        android:layout_width="110dp"
                        android:layout_height="160dp"
                        android:layout_marginEnd="12dp"
                        android:contentDescription="@string/fg_home_portada"
                        android:scaleType="centerCrop"
                        android:src="@mipmap/circe_portada"
                        app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Small" />
                </LinearLayout>
            </HorizontalScrollView>

        </LinearLayout>
</ScrollView>



